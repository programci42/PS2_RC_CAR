IOP_BIN = rtl8192cu_wifi.irx
IOP_OBJS = rtl_wifi.o rtl_core.o rtl_bringup.o rtl_radio.o rtl_wire.o rtl_firmware.o imports.o
IOP_OBJS_DIR = obj-wifi/
IOP_INCS = -I../include
all: $(IOP_BIN)
obj-wifi/rtl_wifi.o: rtl_probe.c rtl_wifi_impl.h ../include/rtl_wire.h
obj-wifi/imports.o: imports.lst irx_imports.h
rtl_firmware.c: ../third_party/realtek-firmware/rtl8192cfw.bin
	bin2c $< $@ rtl_firmware_bin
obj-wifi/rtl_firmware.o: rtl_firmware.c
obj-wifi/rtl_core.o: ../src/rtl_core.c
	$(DIR_GUARD)
	$(IOP_CC) $(IOP_CFLAGS) $(IOP_INCS) -c $< -o $@
obj-wifi/rtl_bringup.o: ../src/rtl_bringup.c
	$(DIR_GUARD)
	$(IOP_CC) $(IOP_CFLAGS) $(IOP_INCS) -c $< -o $@
obj-wifi/rtl_radio.o: ../src/rtl_radio.c ../src/rtl_radio_netbsd.inc
	$(DIR_GUARD)
	$(IOP_CC) $(IOP_CFLAGS) $(IOP_INCS) -c $< -o $@
obj-wifi/rtl_wire.o: ../src/rtl_wire.c
	$(DIR_GUARD)
	$(IOP_CC) $(IOP_CFLAGS) $(IOP_INCS) -c $< -o $@
include $(PS2SDK)/samples/Makefile.pref
include $(PS2SDK)/samples/Makefile.iopglobal

obj-wifi/rtl_wifi.o: usb_inventory_impl.h ../include/usb_inventory.h
